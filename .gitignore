# Patterns are intentionally unanchored so they apply inside every tool directory.

# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# secrets — never commit real keys
.env
.env.local
.env.*.local

# python tools
__pycache__/
*.py[cod]
.venv/
venv/

# misc
.DS_Store
*.pem
.vercel

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local editor/agent tooling
.claude/
